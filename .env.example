# Digital Agriculture Extension Prototype — environment template
# Copy to .env and adjust. DEMO DATA only; not production secrets.

POSTGRES_USER=agri_user
POSTGRES_PASSWORD=agri_pass
POSTGRES_DB=agriculture
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg2://agri_user:agri_pass@localhost:5432/agriculture

SECRET_KEY=change-this-academic-demo-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Optional YOLO weights (Ultralytics .pt). If missing, vision uses a labelled DEMO heuristic.
YOLO_WEIGHTS_PATH=../vision/weights/best.pt
YOLO_CONFIDENCE=0.25

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Plant Health AI Model Configuration
PLANT_HEALTH_MODEL_PATH=
PLANT_HEALTH_MODEL_TYPE=yolo
PLANT_HEALTH_MOCK_MODE=true

